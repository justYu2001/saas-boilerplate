{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchConfidence": ["low"],
      "dependencyDashboardApproval": true
    }
  ],
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "labels": ["security"]
  }
}
