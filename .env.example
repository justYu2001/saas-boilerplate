# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth

BETTER_AUTH_URL="http://localhost:3000"

# Secret used by Better Auth
BETTER_AUTH_SECRET=""

# Better Auth Google OAuth
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

# Google One Tap needs the client ID in the browser, so the same value is
# repeated here with a NEXT_PUBLIC_ prefix. Only the ID — never the secret.
#
# The OAuth client must also list every origin One Tap runs on under
# "Authorized JavaScript origins" — a separate field from the redirect URIs the
# sign-in button uses, and one that accepts no wildcards.
#
# Local development needs BOTH of these entries:
#
#   http://localhost:3000
#   http://localhost
#
# Google validates the bare origin alongside the one the dev server serves
# from. With only the :3000 entry, One Tap fails with "The given origin is not
# allowed for the given client ID", which looks identical to having added
# nothing. See the setup section in README.md.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Drizzle
DATABASE_URL="postgresql://postgres:password@db.localtest.me:5432/saas-boilerplate"

# Resend

RESEND_BASE_URL="http://localhost:8005"

RESEND_API_KEY="re_local_dev"

EMAIL_FROM="Acme <onboarding@resend.dev>"

# Crisp
NEXT_PUBLIC_CRISP_WEBSITE_ID=""
